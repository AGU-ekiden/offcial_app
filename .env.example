# ── Notion ───────────────────────────────────────────────
# 公式サイト(agu-ekiden-site)と同じインテグレーションのトークンを使えます。
# 未設定の場合はサンプルデータで動きます。
NOTION_TOKEN=

# 各DBのID（公式サイトの「管理用DB」）。公式サイトと同じ変数名です。
NOTION_DB_NEWS=35fbaada911e8042bf21f3d2e43b0ac4
NOTION_DB_MEMBERS=35fbaada911e8018b6fddde5e4d067fc
NOTION_DB_RESULTS=35fbaada911e8099926cf466fa679254
NOTION_DB_SCHEDULE=35fbaada911e80a3b4eff6e53287259a
NOTION_DB_ONREI=35fbaada911e807384adfcd914974773
NOTION_DB_SPONSORS=360baada911e8039b850ffdd2d6a34d6
NOTION_DB_PHOTOS=364baada911e80809fb1ed7577722ff6
# アプリで新しく使うDB
NOTION_DB_COLUMNS=8326d413be9e4f17b1706f05c25b26e9
NOTION_DB_GOODS=381baada911e805c97d9e1435b93f175

# ── 即時反映用 ───────────────────────────────────────────
# /api/revalidate?secret=... を叩くと Notion の最新内容がすぐ反映されます。
# 推測されにくい長いランダム文字列にしてください（例: openssl rand -hex 32）
REVALIDATE_SECRET=

# ── 公式SNS（空欄なら表示しません）──────────────────────
NEXT_PUBLIC_SNS_INSTAGRAM=
NEXT_PUBLIC_SNS_X=
NEXT_PUBLIC_SNS_YOUTUBE=
