# ── Notion ───────────────────────────────────────────────
# 公式サイト(agu-ekiden-site)と同じインテグレーションのトークンを使えます。
# 未設定の場合はアプリ全体がサンプルデータ（架空）で動きます。
# 設定した場合、DB ID が空の項目はサンプルを混ぜずに「データなし」として表示します。
NOTION_TOKEN=

# ── 連携するDB ───────────────────────────────────────────
# お知らせDB
NOTION_DB_NEWS=35fbaada911e8042bf21f3d2e43b0ac4
# 競技結果DB（個人）
NOTION_DB_RESULTS=35fbaada911e8099926cf466fa679254
# 予定DB
NOTION_DB_SCHEDULE=35fbaada911e80a3b4eff6e53287259a
# 高校自己ベストDB
NOTION_DB_HS_BESTS=166c6e4bf70540a0a03bfb2f7289c08e
# 大学結果DB（チーム成績）
NOTION_DB_TEAM_RESULTS=742dddd24dba4f25beb279a3272599bb
# 駅伝青学記録
NOTION_DB_EKIDEN_RECORDS=3e6baada911e8057aa2ecf25bb794c55

# ── 任意（必要になったら設定）──────────────────────────
# 部員DB: 結果の選手名・選手名鑑・高校ベストの表示に必要です
NOTION_DB_MEMBERS=
NOTION_DB_COLUMNS=
NOTION_DB_SPONSORS=
NOTION_DB_GOODS=
NOTION_DB_ONREI=
NOTION_DB_PHOTOS=

# ── 即時反映用 ───────────────────────────────────────────
# /api/revalidate?secret=... を叩くと Notion の最新内容がすぐ反映されます。
# 推測されにくい長いランダム文字列にしてください（例: openssl rand -hex 32）
REVALIDATE_SECRET=

# ── 公式SNS（空欄なら表示しません）──────────────────────
NEXT_PUBLIC_SNS_INSTAGRAM=
NEXT_PUBLIC_SNS_X=
NEXT_PUBLIC_SNS_YOUTUBE=
